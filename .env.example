# Необязательные настройки локальной демонстрации. Скопируйте в .env в корне.
# Файл с настоящими ключами не добавляйте в Git.
GIGA_TOKEN=
GIGA_MODEL=GigaChat-Pro
WEB_CONCURRENCY=4
FSP_ID_MODE=mock
# Для серверного развёртывания требуются отдельные настройки безопасности,
# ENVIRONMENT=prod, HTTPS и реальные секреты; текущий compose предназначен для dev.
