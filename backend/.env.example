# Скопируйте в .env и поправьте значения:  cp .env.example .env
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://fsp:fsp@localhost:5432/fsp

# Обязательно смените на длинную случайную строку на сервере:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME-IN-PRODUCTION-please-use-long-random-string

# Ключ шифрования персональных данных (AES-256). Сгенерировать: python -m scripts.encryption gen-key
# Пусто = dev-ключ (только для разработки). В продакшене обязателен — без него сервер не стартует.
DATA_ENCRYPTION_KEYS=

EMAIL_VERIFICATION_REQUIRED=true
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
# Пусто = письма печатаются в консоль. В docker-compose используется Mailpit (localhost:8025)
SMTP_HOST=
SMTP_PORT=1025

# ML-сервис участника 3 (POST /api/cv/parse). Пусто — встроенный парсер. В Docker: http://ml:8000
ML_SERVICE_URL=
# Ключ GigaChat для ML-сервиса. Только здесь, в .env — НЕ в коде и НЕ в git
GIGA_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Вход через FSP ID: mock — встроенная имитация Keycloak-реалма ФСП; oidc — настоящий Keycloak; off — выключен
FSP_ID_MODE=mock
FSP_ID_ISSUER=
FSP_ID_CLIENT_ID=fsp-talent
FSP_ID_CLIENT_SECRET=dev-fsp-id-client-secret-change-me

# Реальные результаты ФСП (шаблон: python -m scripts.fsp_data template). Нет ID в таблице -> демо-реестр
FSP_DATA_PATH=data/fsp_results.xlsx
FSP_DEMO_FALLBACK=true

# Тест: число заданий (для экспресс-проверки жюри можно 6)
TEST_QUESTIONS_COUNT=10

# Число процессов сервера в Docker (на 8 CPU — 8)
WEB_CONCURRENCY=4
